record(calc, "{{ rapids_project_name }}:{{ rapids_instance_name | default('vm') }}:procserv-selfcheck:angle") {
    field(SCAN, "1 second")
    field(CALC, "A+0.3")
    field(INPA, "{{ rapids_project_name }}:{{ rapids_instance_name | default('vm') }}:procserv-selfcheck:angle")
}
record(calc, "{{ rapids_project_name }}:{{ rapids_instance_name | default('vm') }}:procserv-selfcheck:sine") {
    field(SCAN, "1 second")
    field(CALC, "SIN(A)")
    field(INPA, "{{ rapids_project_name }}:{{ rapids_instance_name | default('vm') }}:procserv-selfcheck:angle")
}
