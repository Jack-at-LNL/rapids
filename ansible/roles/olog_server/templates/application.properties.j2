# ============================================================================
# RAPIDS - Olog Service Configuration
# ============================================================================

# Server Configuration - HTTP only, no HTTPS
server.port={{ olog_port }}
server.http.enable=false
security.require-ssl=false
server.ssl.enabled=false

# ElasticSearch Configuration
elasticsearch.network.host=localhost
elasticsearch.http.port=9200
elasticsearch.cluster.name=olog-cluster
elasticsearch.create.indices=true

# MongoDB Configuration
mongo.host=localhost
mongo.port=27017
mongo.database=olog

# File Upload Limits (MB)
spring.servlet.multipart.max-file-size=50MB
spring.servlet.multipart.max-request-size=100MB

# Authentication
spring.security.user.name={{ olog_admin_user }}
spring.security.user.password={{ olog_admin_password }}

# Logging
logging.level.org.phoebus.olog={{ olog_log_level | default('INFO') }}
logging.level.org.springframework=WARN
logging.file.name={{ olog_log_dir }}/olog.log

# CORS
cors.allowed.origins=*

# Index Names
elasticsearch.log.index=olog_logs
elasticsearch.tag.index=olog_tags
elasticsearch.logbook.index=olog_logbooks
elasticsearch.property.index=olog_properties
