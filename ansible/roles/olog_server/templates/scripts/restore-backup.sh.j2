#!/bin/bash
# Olog Restore Script
# Created by RAPIDS Ansible deployment

set -e

if [ $# -ne 1 ]; then
    echo "Usage: $0 <backup_file.tar.gz>"
    echo ""
    echo "Available backups:"
    ls -lht {{ olog_backup_dir }}/*.tar.gz 2>/dev/null || echo "  No backups found"
    exit 1
fi

BACKUP_FILE="$1"

if [ ! -f "$BACKUP_FILE" ]; then
    echo "Error: Backup file not found: $BACKUP_FILE"
    exit 1
fi

echo "=== Olog Restore Started at $(date) ==="
echo "Backup file: $BACKUP_FILE"
echo ""
echo "WARNING: This will OVERWRITE current Olog data!"
read -p "Are you sure you want to continue? (type 'yes' to confirm): " confirm

if [ "$confirm" != "yes" ]; then
    echo "Restore cancelled"
    exit 0
fi

TEMP_DIR="/tmp/olog-restore-$$"
mkdir -p "$TEMP_DIR"

# Extract backup
echo "Extracting backup..."
tar -xzf "$BACKUP_FILE" -C "$TEMP_DIR"

# Stop services
echo "Stopping services..."
systemctl stop olog
systemctl stop elasticsearch
systemctl stop mongod

# Restore MongoDB
echo "Restoring MongoDB..."
if [ -d "${TEMP_DIR}/mongodb" ]; then
    mongorestore --host localhost --port 27017 \
        --drop \
        --dir "${TEMP_DIR}/mongodb"
fi

# Restore configuration
echo "Restoring configuration..."
if [ -d "${TEMP_DIR}/config" ]; then
    cp -r ${TEMP_DIR}/config/* {{ olog_install_dir }}/config/
fi

# Cleanup
rm -rf "$TEMP_DIR"

# Start services
echo "Starting services..."
systemctl start mongod
sleep 5
systemctl start elasticsearch
sleep 10
systemctl start olog
sleep 5

echo "=== Restore Complete at $(date) ==="
echo ""
echo "Verifying services..."
systemctl status olog elasticsearch mongod --no-pager

echo ""
echo "Test API:"
echo "  curl -u {{ olog_admin_user }}:{{ olog_admin_password }} http://localhost:{{ olog_port }}/Olog"
