#!/bin/bash
# Olog Manual Backup Script
# Created by RAPIDS Ansible deployment

BACKUP_DIR="{{ olog_backup_dir }}"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
BACKUP_FILE="${BACKUP_DIR}/olog-backup-${TIMESTAMP}.tar.gz"
TEMP_DIR="/tmp/olog-backup-$$"

echo "=== Olog Backup Started at $(date) ==="

# Create temporary directory
mkdir -p "$TEMP_DIR/mongodb"

# Backup MongoDB
echo "Backing up MongoDB..."
mongodump --host localhost --port 27017 \
  --db olog \
  --out "$TEMP_DIR/mongodb" \
  --quiet

# Backup configuration
echo "Backing up configuration..."
mkdir -p "$TEMP_DIR/config"
cp -r {{ olog_install_dir }}/config/* "$TEMP_DIR/config/"

# Create manifest
echo "Creating manifest..."
cat > "$TEMP_DIR/manifest.txt" << MANIFEST
Olog Backup
Date: $(date)
MongoDB: Yes
Configuration: Yes
MANIFEST

# Create compressed archive
echo "Creating archive..."
tar -czf "$BACKUP_FILE" -C "$TEMP_DIR" .

# Cleanup
rm -rf "$TEMP_DIR"

# Set permissions
chmod 600 "$BACKUP_FILE"

echo "=== Backup Complete ==="
echo "Backup file: $BACKUP_FILE"
echo "Size: $(du -h "$BACKUP_FILE" | cut -f1)"
ls -lh "$BACKUP_FILE"
