#!/bin/bash
# Olog Tags Management Script
# Created by RAPIDS Ansible deployment

OLOG_URL="{{ olog_server_url }}"
OLOG_USER="{{ olog_admin_user }}"
OLOG_PASS="{{ olog_admin_password }}"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

function usage() {
    echo "Usage: $0 [add|delete|list] [tag_name]"
    echo ""
    echo "Commands:"
    echo "  add TAG_NAME      - Add a new tag"
    echo "  delete TAG_NAME   - Delete a tag"
    echo "  list              - List all tags"
    exit 1
}

function list_tags() {
    echo -e "${YELLOW}=== Current Tags ===${NC}"
    curl -s "${OLOG_URL}/tags" -u "${OLOG_USER}:${OLOG_PASS}" | \
        jq -r '.[] | "  - \(.name) (state: \(.state))"' | sort
}

function add_tag() {
    local name="$1"
    
    if [ -z "$name" ]; then
        echo -e "${RED}Error: Tag name required${NC}"
        usage
    fi
    
    echo -e "${YELLOW}Adding tag: ${name}${NC}"
    
    response=$(curl -s -w "\n%{http_code}" -X PUT "${OLOG_URL}/tags/${name}" \
        -u "${OLOG_USER}:${OLOG_PASS}" \
        -H "Content-Type: application/json" \
        -d "{\"name\": \"${name}\", \"state\": \"Active\"}")
    
    http_code=$(echo "$response" | tail -n1)
    
    if [ "$http_code" -eq 200 ] || [ "$http_code" -eq 201 ]; then
        echo -e "${GREEN}✓ Tag '${name}' added${NC}"
    else
        echo -e "${RED}✗ Failed to add tag${NC}"
        exit 1
    fi
}

function delete_tag() {
    local name="$1"
    
    if [ -z "$name" ]; then
        echo -e "${RED}Error: Tag name required${NC}"
        usage
    fi
    
    echo -e "${YELLOW}Deleting tag: ${name}${NC}"
    read -p "Are you sure? (yes/no): " confirm
    
    if [ "$confirm" != "yes" ]; then
        echo "Cancelled"
        exit 0
    fi
    
    response=$(curl -s -w "\n%{http_code}" -X DELETE "${OLOG_URL}/tags/${name}" \
        -u "${OLOG_USER}:${OLOG_PASS}")
    
    http_code=$(echo "$response" | tail -n1)
    
    if [ "$http_code" -eq 200 ]; then
        echo -e "${GREEN}✓ Tag '${name}' deleted${NC}"
    else
        echo -e "${RED}✗ Failed to delete tag${NC}"
        exit 1
    fi
}

case "$1" in
    add) add_tag "$2" ;;
    delete) delete_tag "$2" ;;
    list) list_tags ;;
    *) usage ;;
esac
