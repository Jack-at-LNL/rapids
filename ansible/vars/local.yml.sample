# User specific configuration
#
# Copy this file to 'local.yml' (which is gitignored) and change as you like

# You can also create other setup files, e.g., 'myVM.yml'
# and specify it on the ansible-playbook command line:
# ansible-playbook ... playbook.yml -e @vars/myVM.yml

# Flag to rebuild everything from source even if it already exists
# epics_rebuild_all: true

# Modules to be built
m_base: true
m_asyn: true
m_stream: true

# Services
# phoebus: true
# archiver_appliance: true
# docker: true
# bluesky: true

# ---------------------------------------------------------------------------
# RAPIDS roles (https://github.com/Jack-at-LNL/rapids)
# ---------------------------------------------------------------------------
# system_time: true             # NTP synchronisation with chrony
# olog_server: true             # Olog electronic logbook server (needs phoebus: true for Maven)
# olog_client_config: true      # Phoebus: Olog logbook (Ctrl+L)   - needs phoebus: true
# archiver_client_config: true  # Phoebus: Archiver data (Ctrl+D)  - needs phoebus: true

# Project branding
# AVOID '-', ':', AND SPACES IN rapids_project_name AND
# rapids_instance_name (below). '-' and ':' become directory separators on
# disk (the Archiver Appliance's ConvertPVNameToKey) - "ANTHEM-SPES" is
# stored as a literal nested folder ANTHEM/SPES, not as one name - harmless,
# but confusing to browse. A space is worse: confirmed directly, a space in
# either name breaks the Archiver healthcheck's own test PVs outright - the
# Archiver's REST API cannot resolve a PV name containing an unencoded space
# ("archive request ... no answer from the management interface"), so every
# downstream check fails. EPICS PV names are conventionally space-free by
# community convention anyway - use an underscore or just run words together.
# rapids_project_name: "MyProject"
# rapids_author_name: "Your Name"
# rapids_author_email: "your.email@example.org"
# rapids_institution: "Your Institution"

# Unique per-instance identifier, used in the Archiver healthcheck's and the
# procServ self-check's test PV names. Recommended whenever more than one
# RAPIDS installation might run on the same network: without it, two
# installs of the same project could serve PVs with identical names (e.g.
# two "My Project:healthcheck:counter"), and EPICS clients could connect to
# either one unpredictably. Also use this convention for any production IOC
# you create yourself with manage-procs (see rapids_procserv below). Give
# each VM/installation its own value - the hostname or a short site/unit
# label, never the project name itself.
# rapids_instance_name: "vm01"

# procServ: installs procServ and manage-procs (the EPICS community's own
# systemd integration, see doc/rapids/procserv-manual.md) so you can run
# your own production IOCs as properly supervised, reboot-surviving
# services. RAPIDS does not create or manage any production IOC itself -
# it only installs the tool and runs a one-time, self-disabling check that
# proves the installation genuinely works.
# rapids_procserv: true
# rapids_procserv_selfcheck: true

# Olog: default logbooks and tags, seeded once at install time (requires
# olog_server: true). The first logbook is named after the project itself
# (rapids_project_name, set above) so every entry has a home from day one;
# the rest reflect how a control room actually files entries. Edit freely -
# olog_users below still needs its own vault-encrypted passwords.
# olog_initial_logbooks:
#   - { name: "{{ rapids_project_name }}", owner: "olog-logs", state: "Active" }
#   - { name: "operations",    owner: "olog-logs", state: "Active" }
#   - { name: "commissioning", owner: "olog-logs", state: "Active" }
#   - { name: "maintenance",   owner: "olog-logs", state: "Active" }
#   - { name: "faults",        owner: "olog-logs", state: "Active" }
# olog_initial_tags:
#   - { name: "follow-up" }
#   - { name: "resolved" }
#   - { name: "reference" }

# Time servers (first entry is primary, the others are fallbacks)
# ntp_servers:
#   - ntp.example.org
#   - pool.ntp.org

# Service endpoints (defaults: this machine)
# olog_server_url: "http://olog.example.org:8080/Olog"
# archappl_host: archiver.example.org

# Olog administrator password - REQUIRED when olog_server is true.
# Do not write it in clear text: encrypt it with
#   ansible-vault encrypt_string 'YourPassword' --name 'olog_admin_password'
# paste the result here, and run:  vm-setup/update.sh --ask-vault-pass
# olog_admin_password: !vault |
#   ...

# Personal Olog accounts (passwords in the vault, one value per user):
#   ansible-vault encrypt_string 'Password1' --name 'olog_user1_password' >> local.yml
# olog_users:
#   - { name: user1, password: "{{ olog_user1_password }}", admin: true }
#   - { name: user2, password: "{{ olog_user2_password }}" }
#   - { name: user3, password: "{{ olog_user3_password }}" }

# Firewall: extra ports for this site (Channel Access, PV Access, Olog and the
# Archiver are opened automatically)
# rapids_firewall_extra_ports: ['5065/udp']
