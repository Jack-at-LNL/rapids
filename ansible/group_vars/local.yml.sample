# User specific configuration
# Copy this sample file to local.yml then change it

# Activate/deactivate optional roles by uncommenting the associated variable below
# (default settings are defined in all.yml)
#initial_setup: true # only used for Vagrant build
#docker: false # for rootful this needs to happen before first reboot
#catrust: true
#phoebus: true
#oac_tree: true
#archiver_appliance: true
#bluesky: true

# RAPIDS roles
#system_time: true             # NTP synchronisation with chrony
#olog_server: true             # Olog electronic logbook server
#olog_client_config: true      # Phoebus: Olog logbook (Ctrl+L)   - needs phoebus: true
#archiver_client_config: true  # Phoebus: Archiver data (Ctrl+D)  - needs phoebus: true

# RAPIDS project branding
#rapids_project_name: "My Project"
#rapids_author_name: "Your Name"
#rapids_author_email: "your.email@example.org"
#rapids_institution: "Your Institution"

# RAPIDS time servers (first entry is primary, the others are fallbacks)
#ntp_servers:
#  - ntp.example.org
#  - pool.ntp.org

# RAPIDS service endpoints
#olog_server_host: olog.example.org
#archappl_host: archiver.example.org

# RAPIDS Olog administrator password - REQUIRED when olog_server is true.
# Do not write it here in clear text: encrypt it with
#   ansible-vault encrypt_string 'YourPassword' --name 'olog_admin_password'
# and paste the result below.
#olog_admin_password: !vault |
#  ...

# List the EPICS modules that will be built
m_base: true
#m_p4p: true
#m_pvaPy: true
#m_seq: true
#m_areadetector: true
#m_opcua: true
#m_stream: true

# Set proxies, if needed
#proxy_env:
#  http_proxy: http://proxy.example.com:8080
#  https_proxy: http://proxy.example.com:8080

#proxy_mvn:
#  - <proxy><id>httpproxy</id><active>true</active><protocol>http</protocol><host>proxy.example.com</host><port>8080</port></proxy>
#  - <proxy><id>httpsproxy</id><active>true</active><protocol>https</protocol><host>proxy.example.com</host><port>8080</port></proxy>


# [catrust] CA certificate to work through corporate firewall with deep packet inspection
# (like e.g. ITER uses)
#root_ca_url: "http://pki.iter.org/CertEnroll/io-ws-pkiroot_ITER%20Organization%20Root%20CA.crt"

#ca_trust_folder: "/var/lib/training-vm/ca_trust"
#ca_trust_der_path: "{{ ca_trust_folder }}/corporate_root_ca.der.crt"
#ca_trust_pem_path: "{{ ca_trust_folder }}/corporate_root_ca.pem.crt"
